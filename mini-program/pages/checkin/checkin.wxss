/* 提醒打卡页 ---------------------------------------------------- */
.page--checkin {
  padding-bottom: 24rpx;
}

.empty-wrap {
  padding: 160rpx 24rpx 0;
}

/* ================= Hero 补充 ================= */
.hero-kicker,
.hero-title,
.hero-sub {
  position: relative;
  z-index: 1;
}
.hero-meta {
  position: relative;
  z-index: 1;
}
.hero-meta-item {
  flex: 1;
}

/* ================= 提醒设置卡 ================= */
.channel-badge {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}
.channel-badge.is-on {
  color: #0d8f52;
  background: var(--xl-success-soft);
}
.channel-badge.is-off {
  color: var(--xl-muted);
  background: #f1f4f9;
}

.reminder-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--xl-line-2);
}
.reminder-row:last-of-type {
  border-bottom: none;
}
.reminder-label {
  font-size: 28rpx;
  color: var(--xl-ink-2);
}
.reminder-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--xl-ink);
}
.time-value {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 22rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--xl-brand-deep);
  background: var(--xl-brand-soft);
}
.time-arrow {
  font-size: 26rpx;
  color: var(--xl-brand);
}

.hint-box {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--xl-ink-2);
  background: #f7f9fc;
}
.fallback-box {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #b96a00;
  background: var(--xl-warning-soft);
}
.cron-line {
  margin-top: 18rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--xl-muted);
}
.next-training {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--xl-info);
}

/* ================= 定位提示卡 ================= */
.located-card {
  border: 2rpx solid var(--xl-brand-line);
}
.located-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.located-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--xl-ink);
}
.located-close {
  font-size: 24rpx;
  color: var(--xl-muted);
}
.located-plan {
  margin-top: 18rpx;
}
.located-card .form-hint {
  margin-top: 16rpx;
}

/* ================= 今日训练卡 ================= */
.phase-badge {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.action-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.action-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 22rpx;
  border-radius: 20rpx;
  background: #f7f9fc;
  border: 2rpx solid transparent;
  transition: background 0.16s ease, border-color 0.16s ease;
}
.action-row--hover {
  background: #eef1f6;
}
.action-row.is-checked {
  background: var(--xl-brand-soft);
  border-color: var(--xl-brand-line);
}
.check-box {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #d7dce7;
  background: #ffffff;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: center;
}
.action-row.is-checked .check-box {
  border-color: var(--xl-brand);
  background: var(--xl-brand);
}
.action-main {
  flex: 1;
  min-width: 0;
}
.action-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--xl-ink);
  line-height: 1.4;
}
.action-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--xl-muted);
}
.action-foot {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--xl-line-2);
}
.action-count {
  font-size: 26rpx;
  color: var(--xl-ink-2);
}
.action-count-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--xl-brand);
  margin: 0 2rpx;
}
.echo-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--xl-success);
}

/* ================= 休息日卡 ================= */
.rest-card {
  text-align: center;
  padding-top: 40rpx;
  padding-bottom: 36rpx;
}
.rest-emoji {
  font-size: 64rpx;
  line-height: 1.2;
  margin-bottom: 12rpx;
}
.rest-next {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  text-align: left;
}
.rest-next-label {
  font-size: 22rpx;
  color: var(--xl-muted);
}
.rest-next-value {
  font-size: 26rpx;
  color: var(--xl-ink-2);
  line-height: 1.5;
}

/* ================= 打卡表单卡 ================= */
.form-badge {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--xl-brand-deep);
  background: var(--xl-brand-soft);
}
.form-card .form-item {
  margin-top: 30rpx;
  margin-bottom: 0;
}
.form-card .form-item:first-of-type {
  margin-top: 26rpx;
}
.note-counter {
  text-align: right;
}

/* ================= 安全提示 / 周完成提示 ================= */
.safety-card {
  border: 2rpx solid #ffd0c4;
  background: linear-gradient(180deg, #fff6f2 0%, #ffffff 100%);
}
.safety-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--xl-danger);
}
.safety-msg {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--xl-ink-2);
}
.safety-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.week-tip {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.week-tip-main {
  flex: 1;
  min-width: 0;
}
.week-tip-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--xl-ink);
}
.week-tip-text {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--xl-muted);
}
.week-tip .btn {
  flex-shrink: 0;
}

/* ================= 打卡历史 ================= */
.history-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--xl-line-2);
}
.history-row:last-child {
  border-bottom: none;
  padding-bottom: 6rpx;
}
.history-date {
  flex-shrink: 0;
  width: 96rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--xl-muted);
  font-variant-numeric: tabular-nums;
}
.history-main {
  flex: 1;
  min-width: 0;
}
.history-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--xl-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.history-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--xl-muted);
}
.history-status {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 600;
}
.history-status.is-done {
  color: #0d8f52;
  background: var(--xl-success-soft);
}
.history-status.is-partial {
  color: #b96a00;
  background: var(--xl-warning-soft);
}
.history-status.is-skipped {
  color: var(--xl-muted);
  background: #f1f4f9;
}
.history-status.is-pending {
  color: #1c6bc4;
  background: var(--xl-info-soft);
}

.history-empty {
  padding: 44rpx 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.history-empty-icon {
  font-size: 52rpx;
  line-height: 1.2;
}
.history-empty-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--xl-muted);
  text-align: center;
}
