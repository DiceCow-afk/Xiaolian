<view class="page page--checkin">
  <state-view
    state="{{viewState}}"
    text="{{errorText}}"
    min-height="70vh"
    bindretry="onRetry"
  >
    <block wx:if="{{plan}}">
      <!-- ================= Hero ================= -->
      <view class="hero hero-orange">
        <view class="hero-deco hero-deco-1"></view>
        <view class="hero-deco hero-deco-2"></view>
        <text class="hero-kicker">{{heroKicker}}</text>
        <view class="hero-title">{{heroTitle}}</view>
        <view class="hero-sub">完成情况 + RPE + 不适反馈会被带入周反馈与动态调整</view>
        <view class="hero-meta">
          <view class="hero-meta-item">
            <text class="hero-meta-value">{{streak}}</text>
            <text class="hero-meta-label">连续打卡（天）</text>
          </view>
          <view class="hero-meta-item">
            <text class="hero-meta-value">{{weekDoneText}}</text>
            <text class="hero-meta-label">本周完成</text>
          </view>
          <view class="hero-meta-item">
            <text class="hero-meta-value">{{subscriptionQuota}}</text>
            <text class="hero-meta-label">订阅额度（条）</text>
          </view>
        </view>
      </view>

      <view class="content">
        <!-- ================= 计划页定位提示（非今天时） ================= -->
        <view wx:if="{{locatedSession}}" id="located-card" class="card located-card fade-in">
          <view class="located-hd">
            <view class="located-title">📍 {{locatedText}}</view>
            <text class="located-close" bindtap="onClearLocated">关闭</text>
          </view>
          <view class="card-sub">{{locatedSession.day_label}} · {{locatedSession.title}}</view>
          <view class="located-plan">
            <plan-card
              session="{{locatedSession}}"
              mode="compact"
              show-status="{{true}}"
              bindactiontap="onLocatedActionTap"
            ></plan-card>
          </view>
          <view class="form-hint">打卡页默认记录今天；该训练日可在「计划」页查看。</view>
        </view>

        <!-- ================= 提醒设置卡 ================= -->
        <view class="card reminder-card">
          <view class="card-hd">
            <view>
              <view class="card-title">训练提醒</view>
              <view class="card-sub">{{reminderChannelLabel}} · 提醒时间 {{reminderTime}}</view>
            </view>
            <view class="channel-badge {{reminderEnabled ? 'is-on' : 'is-off'}}">
              {{reminderEnabled ? '已开启' : '已关闭'}}
            </view>
          </view>

          <view class="reminder-row">
            <view class="reminder-label">开启训练日提醒</view>
            <switch
              checked="{{reminderEnabled}}"
              color="#FF6B2C"
              bindchange="onReminderToggle"
            ></switch>
          </view>

          <view class="reminder-row">
            <view class="reminder-label">提醒时间</view>
            <picker mode="time" value="{{reminderTime}}" bindchange="onReminderTimeChange">
              <view class="time-value">{{reminderTime}}<text class="time-arrow">›</text></view>
            </picker>
          </view>

          <view class="reminder-row">
            <view class="reminder-label">剩余订阅额度</view>
            <view class="reminder-value">{{subscriptionQuota}} 条</view>
          </view>

          <view class="hint-box">
            体育类小程序通常只能拿到「一次性订阅」，授权一次可推送有限条；不可用时使用应用内角标提醒。
          </view>
          <view wx:if="{{!templateReady}}" class="fallback-box">
            💡 订阅消息模板尚未配置，已启用「应用内提醒」兜底：训练日会在「打卡」tab 显示角标。
          </view>
          <view class="cron-line">🕒 服务端定时任务：{{serverCron}}</view>
          <view wx:if="{{nextTrainingTitle}}" class="next-training">
            下一训练日：{{nextTrainingLabel}} · {{nextTrainingTitle}}
          </view>
          <view wx:else class="next-training">本周期暂无后续训练日</view>

          <view
            class="btn btn-primary btn-block btn-sm mt-24 {{subscribing ? 'btn-disabled' : ''}}"
            bindtap="onSubscribeTap"
          >{{subscribing ? '正在请求授权…' : '授权订阅消息'}}</view>
        </view>

        <!-- ================= 今日训练卡 / 休息日卡 ================= -->
        <view wx:if="{{todaySession}}" id="today-card" class="card today-card fade-in">
          <view class="card-hd">
            <view class="flex-1">
              <view class="card-title">{{todaySession.title}}</view>
              <view class="card-sub">{{todayDateText}} · {{todaySession.duration_text}} · {{todaySession.location}}</view>
            </view>
            <view
              wx:if="{{todayPhaseName}}"
              class="phase-badge"
              style="color: {{todayPhaseColor}}; background: {{todayPhaseBg}};"
            >{{todayPhaseName}}</view>
          </view>

          <view class="action-list">
            <view
              wx:for="{{todayActions}}"
              wx:key="action_id"
              class="action-row {{item.checked ? 'is-checked' : ''}}"
              data-index="{{index}}"
              bindtap="onToggleAction"
              hover-class="action-row--hover"
            >
              <view class="check-box">{{item.checked ? '✓' : ''}}</view>
              <view class="action-main">
                <view class="action-name">{{item.name}}</view>
                <view class="action-meta">{{item.role_label}} · {{item.reps_text}} · 休息 {{item.rest_text}}</view>
              </view>
            </view>
          </view>

          <view class="action-foot">
            <view class="action-count">已完成动作 <text class="action-count-num">{{completedCount}}</text> / {{todayActionTotal}}</view>
            <view wx:if="{{todayRecord}}" class="echo-tip">{{echoText}}</view>
          </view>
        </view>

        <view wx:else class="card rest-card">
          <view class="rest-emoji">🌿</view>
          <view class="card-title">今天没有安排训练</view>
          <view class="card-sub">散步、拉伸 10 分钟即可；恢复也是训练的一部分。</view>
          <view class="divider"></view>
          <view wx:if="{{nextTrainingTitle}}" class="rest-next">
            <text class="rest-next-label">下一训练日</text>
            <text class="rest-next-value">{{nextTrainingLabel}} · {{nextTrainingTitle}}</text>
          </view>
          <view wx:else class="rest-next">
            <text class="rest-next-value">本周期暂无后续训练日</text>
          </view>
          <view class="btn btn-ghost btn-block mt-24" bindtap="goPlan">查看下周计划</view>
        </view>

        <!-- ================= 打卡表单卡 ================= -->
        <view wx:if="{{todaySession}}" class="card form-card">
          <view class="card-hd">
            <view class="card-title">{{formTitle}}</view>
            <view class="form-badge">本周完成率 {{completionPercent}}%</view>
          </view>

          <view class="form-item">
            <view class="form-label">完成情况<text class="required">*</text></view>
            <tag-picker
              options="{{statusOptions}}"
              value="{{form.status}}"
              layout="cards"
              bindchange="onStatusChange"
            ></tag-picker>
            <view wx:if="{{formErrors.status}}" class="form-error">{{formErrors.status}}</view>
          </view>

          <view class="form-item">
            <view class="form-label">RPE 主观强度<text class="required">*</text></view>
            <rpe-slider value="{{form.rpe}}" bindchange="onRpeChange"></rpe-slider>
            <view wx:if="{{formErrors.rpe}}" class="form-error">{{formErrors.rpe}}</view>
          </view>

          <view class="form-item">
            <view class="form-label">身体不适反馈<text class="required">*</text></view>
            <tag-picker
              options="{{discomfortOptions}}"
              value="{{form.discomfort}}"
              multiple="{{true}}"
              exclusive-value="none"
              bindchange="onDiscomfortChange"
            ></tag-picker>
            <input
              wx:if="{{showDiscomfortNote}}"
              class="input mt-16"
              value="{{form.discomfortNote}}"
              maxlength="60"
              placeholder="简单描述不适位置 / 程度（选填）"
              placeholder-class="input-placeholder"
              bindinput="onDiscomfortNoteInput"
            ></input>
            <view wx:if="{{formErrors.discomfort}}" class="form-error">{{formErrors.discomfort}}</view>
            <view class="form-hint">记录只用于安全复查；如出现持续疼痛，请停止训练并及时就医。</view>
          </view>

          <view class="form-item">
            <view class="form-label">训练备注<text class="form-optional">选填 · 最多 100 字</text></view>
            <textarea
              class="textarea"
              value="{{form.note}}"
              maxlength="100"
              placeholder="今天训练的感受、动作完成质量…"
              placeholder-class="input-placeholder"
              bindinput="onNoteInput"
            ></textarea>
            <view class="form-hint note-counter">{{noteLength}}/100</view>
            <view wx:if="{{formErrors.note}}" class="form-error">{{formErrors.note}}</view>
          </view>

          <view
            class="btn btn-primary btn-block {{submitting ? 'btn-disabled' : ''}}"
            bindtap="onSubmitCheckin"
          >{{submitting ? '正在提交…' : submitText}}</view>
        </view>

        <!-- ================= 提交结果 / 周完成提示 ================= -->
        <view id="submit-area">
          <view wx:if="{{safetyReview}}" class="card safety-card fade-in">
            <view class="safety-title">🛡️ 安全提示</view>
            <view class="safety-msg">{{safetyReview.message}}</view>
            <view class="safety-tags">
              <text
                wx:for="{{safetyReview.limit_labels}}"
                wx:key="*this"
                class="tag tag-danger"
              >{{item}}</text>
            </view>
          </view>

          <view wx:if="{{weekCompletionTip}}" class="card week-tip fade-in">
            <view class="week-tip-main">
              <view class="week-tip-title">本周训练完成 🎉</view>
              <view class="week-tip-text">完成率 {{completionPercent}}%，去写周反馈，让计划跟着你的身体调整。</view>
            </view>
            <view class="btn btn-sm btn-outline" bindtap="goFeedback">去写周反馈</view>
          </view>
        </view>

        <!-- ================= 打卡历史 ================= -->
        <view class="card">
          <view class="card-hd">
            <view class="card-title">打卡历史</view>
            <view class="card-sub">最近 {{historyItems.length}} 条</view>
          </view>
          <block wx:if="{{historyItems.length}}">
            <view wx:for="{{historyItems}}" wx:key="checkin_id" class="history-row">
              <view class="history-date">{{item.dateText}}</view>
              <view class="history-main">
                <view class="history-title">{{item.title}}</view>
                <view class="history-meta">
                  RPE {{item.rpe}}
                  <text wx:if="{{item.discomfortText}}"> · {{item.discomfortText}}</text>
                </view>
              </view>
              <view class="history-status {{item.statusClass}}">{{item.statusLabel}}</view>
            </view>
          </block>
          <view wx:else class="history-empty">
            <text class="history-empty-icon">📝</text>
            <text class="history-empty-text">还没有打卡记录，完成今天的训练后这里会出现记录。</text>
          </view>
        </view>

        <view class="safe-bottom"></view>
      </view>
    </block>

    <!-- ================= 无计划空状态 ================= -->
    <view wx:else class="empty-wrap">
      <empty-state
        icon="🏃"
        title="还没有训练计划"
        desc="完成约束输入后，会根据你的体测弱项生成 4 周计划，然后就能按天打卡了。"
        action-text="去填写约束"
        bindaction="goConstraints"
      ></empty-state>
    </view>
  </state-view>
</view>
