/* 饮食提示页（页面级样式，组件样式由各组件自带） */
.page--diet {
  padding-bottom: 0;
}

/* ================= Hero 补充 ================= */
.hero-meta-value--sm {
  font-size: 27rpx;
  line-height: 1.3;
}
.hero-meta-item--tap {
  transition: transform 0.16s ease, background 0.16s ease;
}
.hero-meta-item--tap:active {
  transform: scale(0.97);
  background: rgba(255, 255, 255, 0.24);
}

/* ================= 今日训练卡 ================= */
.train-card {
  overflow: hidden;
}
.train-hd {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.train-emoji {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  font-size: 44rpx;
  background: var(--xl-success-soft);
}
.train-main {
  flex: 1;
  min-width: 0;
}
.train-label {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--xl-ink);
  line-height: 1.35;
}
.train-title {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--xl-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.train-note {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #2c7a55;
  background: #f0faf5;
}
.train-ft {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.train-btn {
  flex-shrink: 0;
  min-width: 170rpx;
}

/* ================= 食物选择卡 ================= */
.food-card {
  overflow: hidden;
}
.food-group {
  margin-top: 26rpx;
}
.food-group-hd {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.food-group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--xl-ink);
}
.food-group-desc {
  font-size: 21rpx;
  color: var(--xl-muted-2);
}
.intake-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.intake-title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--xl-ink);
}
.intake-updating {
  font-size: 22rpx;
  color: var(--xl-success);
}
.stat-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--xl-muted);
}
.food-picked {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.food-picked-item {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--xl-ink-2);
  background: #f4f7fb;
}

/* ================= 维度提示卡 ================= */
.tip-card {
  transition: opacity 0.2s ease;
}
.tip-card--updating {
  opacity: 0.6;
}
.tip-hd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.tip-title-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.tip-icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  font-size: 38rpx;
  background: #f2fbf6;
}
.tip-title-main {
  flex: 1;
  min-width: 0;
}
.tip-nums {
  margin-top: 20rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.tip-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--xl-ink);
  font-variant-numeric: tabular-nums;
}
.tip-num--target {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--xl-muted);
}
.tip-progress {
  margin-top: 12rpx;
}
.bar-warn {
  background: linear-gradient(90deg, #f79009 0%, #ffb84d 100%);
}
.bar-ok {
  background: linear-gradient(90deg, #12b76a 0%, #4fd99c 100%);
}
.bar-high {
  background: linear-gradient(90deg, #2e90fa 0%, #6db4ff 100%);
}
.tip-message {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--xl-ink-2);
  background: #f7f9fc;
}
.tip-suggest {
  margin-top: 18rpx;
}
.tip-suggest-label {
  font-size: 22rpx;
  color: var(--xl-muted);
}
.tip-suggest-list {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.suggest-chip {
  color: var(--xl-success);
  background: var(--xl-success-soft);
  border: 2rpx solid transparent;
}
.suggest-chip:active {
  transform: scale(0.96);
}
.suggest-chip--added {
  color: var(--xl-muted);
  background: #f1f4f9;
}

/* ================= 免责声明卡 ================= */
.diet-disclaimer {
  background: linear-gradient(180deg, #fbfefc 0%, #ffffff 60%);
  border: 2rpx solid #e2f5ea;
}
.diet-disclaimer-hd {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.diet-disclaimer-icon {
  font-size: 28rpx;
}
.diet-disclaimer-title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--xl-ink);
}
.diet-disclaimer-text {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--xl-muted);
}
.diet-disclaimer-foot {
  margin-top: 12rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--xl-line-2);
  font-size: 21rpx;
  color: var(--xl-muted-2);
}

