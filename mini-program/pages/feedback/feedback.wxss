/* 周反馈页 ---------------------------------------------------- */
.page--feedback {
  padding-bottom: 24rpx;
}

.empty-wrap {
  padding: 160rpx 24rpx 0;
}

.hero-kicker,
.hero-title,
.hero-sub,
.hero-meta {
  position: relative;
  z-index: 1;
}
.hero-meta-item {
  flex: 1;
}

/* ================= 周切换器 ================= */
.week-switch-card {
  padding: 18rpx;
}
.week-tabs {
  display: flex;
  gap: 12rpx;
}
.week-tab {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 18rpx 6rpx;
  border-radius: 18rpx;
  background: #f4f6fa;
  border: 2rpx solid transparent;
  transition: all 0.16s ease;
}
.week-tab.is-active {
  background: var(--xl-blue-soft);
  border-color: var(--xl-blue);
}
.week-tab-label {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--xl-ink-2);
  white-space: nowrap;
}
.week-tab.is-active .week-tab-label {
  color: var(--xl-blue);
}
.week-tab-status {
  font-size: 20rpx;
  color: var(--xl-muted-2);
  line-height: 1.3;
}
.week-tab-status.is-done {
  color: var(--xl-success);
}

/* ================= 统计卡 ================= */
.rate-circle {
  flex-shrink: 0;
  min-width: 108rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--xl-blue);
  background: var(--xl-blue-soft);
  font-variant-numeric: tabular-nums;
}
.stats-card .progress-bar {
  background: linear-gradient(90deg, #2f5bea 0%, #6a8dff 100%);
}
.rpe-line {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--xl-line-2);
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
}
.rpe-line-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--xl-ink-2);
}
.rpe-line-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--xl-ink);
  font-variant-numeric: tabular-nums;
}
.rpe-line-hint {
  font-size: 22rpx;
  color: var(--xl-muted);
}

/* ================= 调整结果卡 ================= */
.result-card {
  border: 2rpx solid #dbe3ff;
  background: linear-gradient(180deg, #f7f9ff 0%, #ffffff 46%);
}
.result-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.result-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}
.result-time {
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--xl-muted-2);
}
.result-rule {
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--xl-ink-2);
}
.rule-id {
  font-weight: 700;
  color: var(--xl-blue);
}
.result-tag {
  margin-top: 10rpx;
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  color: var(--xl-muted);
  background: #f1f4f9;
}
.result-summary {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--xl-ink-2);
  background: #f7f9fc;
}

.result-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--xl-ink);
  margin-bottom: 14rpx;
}
.preview-meta {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--xl-blue);
  margin-bottom: 6rpx;
}
.preview-focus {
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--xl-muted);
  margin-bottom: 16rpx;
}
.preview-list .plan-card {
  margin-bottom: 18rpx;
}
.preview-empty {
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--xl-muted);
  background: #f7f9fc;
}

.safety-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.safety-change {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f7f9fc;
}
.safety-change-body {
  flex: 1;
  min-width: 0;
}
.safety-change-action {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--xl-ink);
  line-height: 1.5;
}
.safety-change-reason {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--xl-muted);
}

/* ================= 反馈表单卡 ================= */
.form-collapse {
  flex-shrink: 0;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--xl-muted);
  background: #f1f4f9;
}
.form-card .form-item {
  margin-top: 30rpx;
  margin-bottom: 0;
}
.form-card .form-item:first-of-type {
  margin-top: 26rpx;
}
.readonly-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #f7f9fc;
}
.readonly-value {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--xl-blue);
  font-variant-numeric: tabular-nums;
}
.readonly-hint {
  font-size: 22rpx;
  color: var(--xl-muted);
}
.note-counter {
  text-align: right;
}
.submit-hint {
  margin-top: 16rpx;
  text-align: center;
}

/* ================= 历史调整记录 ================= */
.history-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--xl-line-2);
}
.history-row:last-child {
  border-bottom: none;
  padding-bottom: 6rpx;
}
.history-row-hd {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.history-week {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--xl-ink);
}
.history-type {
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.5;
}
.history-rule {
  font-size: 21rpx;
  color: var(--xl-muted);
}
.history-time {
  margin-left: auto;
  font-size: 21rpx;
  color: var(--xl-muted-2);
}
.history-summary {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--xl-muted);
}

.history-empty {
  padding: 44rpx 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.history-empty-icon {
  font-size: 52rpx;
  line-height: 1.2;
}
.history-empty-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--xl-muted);
  text-align: center;
}
