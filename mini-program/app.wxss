/**
 * 校练 · 全局样式 / 设计系统
 * 设计令牌（自定义属性）挂在 page 上，页面与组件可直接 var(--xl-*)
 * 组件内部样式因样式隔离不继承 app.wxss 的类，但会继承 CSS 自定义属性。
 */
page {
  /* 品牌色 */
  --xl-brand: #ff6b2c;
  --xl-brand-deep: #f2551a;
  --xl-brand-soft: #fff1ea;
  --xl-brand-line: #ffd9c7;

  /* 中性色 */
  --xl-ink: #172033;
  --xl-ink-2: #3a4356;
  --xl-muted: #7b8496;
  --xl-muted-2: #a6adbb;
  --xl-line: #e8ecf3;
  --xl-line-2: #f1f4f9;
  --xl-bg: #f4f6fa;
  --xl-card: #ffffff;

  /* 语义色 */
  --xl-success: #12b76a;
  --xl-success-soft: #e7f8ef;
  --xl-warning: #f79009;
  --xl-warning-soft: #fff6e6;
  --xl-danger: #f04438;
  --xl-danger-soft: #fdecea;
  --xl-info: #2e90fa;
  --xl-info-soft: #eaf3ff;
  --xl-blue: #2f5bea;
  --xl-blue-soft: #eef2ff;

  /* 圆角 / 阴影 */
  --xl-radius: 28rpx;
  --xl-radius-lg: 36rpx;
  --xl-radius-sm: 16rpx;
  --xl-shadow: 0 12rpx 32rpx rgba(23, 32, 51, 0.06);
  --xl-shadow-lg: 0 20rpx 48rpx rgba(23, 32, 51, 0.1);

  background: var(--xl-bg);
  color: var(--xl-ink);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
scroll-view,
button,
input,
textarea,
slider,
picker {
  box-sizing: border-box;
}

/* ============ 布局 ============ */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}
.content {
  padding: 0 32rpx;
  margin-top: -48rpx;
  position: relative;
  z-index: 2;
}
.content-flat {
  padding: 24rpx 32rpx 0;
}
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.col {
  display: flex;
  flex-direction: column;
}
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.gap-8 {
  gap: 8rpx;
}
.gap-12 {
  gap: 12rpx;
}
.gap-16 {
  gap: 16rpx;
}
.mt-12 {
  margin-top: 12rpx;
}
.mt-16 {
  margin-top: 16rpx;
}
.mt-24 {
  margin-top: 24rpx;
}
.mt-32 {
  margin-top: 32rpx;
}
.mb-16 {
  margin-bottom: 16rpx;
}
.p-24 {
  padding: 24rpx;
}

/* ============ 顶部 Hero ============ */
.hero {
  position: relative;
  overflow: hidden;
  padding: 44rpx 36rpx 100rpx;
  color: #ffffff;
}
.hero-orange {
  background: linear-gradient(135deg, #ff6b2c 0%, #ff8f4d 58%, #ffab5e 100%);
}
.hero-dark {
  background: linear-gradient(135deg, #172033 0%, #232f4a 62%, #2c3a5c 100%);
}
.hero-blue {
  background: linear-gradient(135deg, #2f5bea 0%, #4a74ff 60%, #6a8dff 100%);
}
.hero-green {
  background: linear-gradient(135deg, #12b76a 0%, #2fce87 60%, #4fd99c 100%);
}
.hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
}
.hero-deco-1 {
  width: 300rpx;
  height: 300rpx;
  right: -90rpx;
  top: -110rpx;
}
.hero-deco-2 {
  width: 180rpx;
  height: 180rpx;
  right: 90rpx;
  bottom: -70rpx;
  background: rgba(255, 255, 255, 0.08);
}
.hero-deco-3 {
  width: 90rpx;
  height: 90rpx;
  left: -30rpx;
  bottom: 20rpx;
  background: rgba(255, 255, 255, 0.1);
}
.hero-kicker {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(10rpx);
}
.hero-title {
  margin-top: 22rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 1rpx;
}
.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
  max-width: 560rpx;
}
.hero-meta {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.hero-meta-item {
  display: flex;
  flex-direction: column;
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.14);
  min-width: 140rpx;
}
.hero-meta-value {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}
.hero-meta-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* ============ 卡片 ============ */
.card {
  background: var(--xl-card);
  border-radius: var(--xl-radius);
  box-shadow: var(--xl-shadow);
  padding: 28rpx;
  margin-bottom: 24rpx;
  position: relative;
}
.card-compact {
  padding: 22rpx 24rpx;
}
.card-hd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--xl-ink);
  line-height: 1.35;
}
.card-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--xl-muted);
}
.card-ft {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--xl-line-2);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.card-tap {
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}
.card-tap:active {
  transform: scale(0.985);
  box-shadow: none;
}

/* ============ 区块 ============ */
.section {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}
.section-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 4rpx 18rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--xl-ink);
  position: relative;
  padding-left: 18rpx;
}
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 30rpx;
  border-radius: 8rpx;
  background: var(--xl-brand);
}
.section-extra {
  font-size: 24rpx;
  color: var(--xl-muted);
}

/* ============ 文本 ============ */
.text-ink {
  color: var(--xl-ink);
}
.text-ink-2 {
  color: var(--xl-ink-2);
}
.text-muted {
  color: var(--xl-muted);
}
.text-brand {
  color: var(--xl-brand);
}
.text-success {
  color: var(--xl-success);
}
.text-warning {
  color: var(--xl-warning);
}
.text-danger {
  color: var(--xl-danger);
}
.text-info {
  color: var(--xl-info);
}
.text-lg {
  font-size: 34rpx;
}
.text-sm {
  font-size: 24rpx;
}
.text-xs {
  font-size: 22rpx;
}
.text-bold {
  font-weight: 700;
}
.text-num {
  font-family: 'DIN Alternate', 'SF Pro Display', 'Helvetica Neue', sans-serif;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.text-break {
  word-break: break-all;
}

/* ============ 胶囊 / 标签 ============ */
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--xl-ink-2);
  background: #f4f6fa;
  border: 2rpx solid transparent;
  transition: all 0.16s ease;
}
.chip-active {
  color: var(--xl-brand);
  background: var(--xl-brand-soft);
  border-color: var(--xl-brand);
  font-weight: 600;
}
.chip-sm {
  padding: 8rpx 18rpx;
  font-size: 22rpx;
}
.chip:active {
  transform: scale(0.97);
}
.tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--xl-ink-2);
  background: #f2f5fa;
}
.tag-brand {
  color: var(--xl-brand-deep);
  background: var(--xl-brand-soft);
}
.tag-success {
  color: #0d8f52;
  background: var(--xl-success-soft);
}
.tag-warning {
  color: #b96a00;
  background: var(--xl-warning-soft);
}
.tag-danger {
  color: #c9342a;
  background: var(--xl-danger-soft);
}
.tag-info {
  color: #1c6bc4;
  background: var(--xl-info-soft);
}
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--xl-brand);
}
.badge-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--xl-brand);
}

/* ============ 按钮 ============ */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 92rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  color: #ffffff;
  background: var(--xl-brand);
  box-shadow: 0 12rpx 26rpx rgba(255, 107, 44, 0.28);
  transition: transform 0.16s ease, opacity 0.16s ease;
}
.btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}
.btn-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #ff6b2c 0%, #ff8f4d 100%);
}
.btn-ghost {
  color: var(--xl-ink-2);
  background: #f4f6fa;
  box-shadow: none;
}
.btn-outline {
  color: var(--xl-brand);
  background: #ffffff;
  border: 2rpx solid var(--xl-brand);
  box-shadow: none;
}
.btn-danger {
  color: #ffffff;
  background: var(--xl-danger);
  box-shadow: none;
}
.btn-sm {
  height: 64rpx;
  padding: 0 26rpx;
  font-size: 26rpx;
  box-shadow: none;
}
.btn-block {
  width: 100%;
}
.btn-disabled {
  opacity: 0.45;
  pointer-events: none;
}
.btn-row {
  display: flex;
  gap: 20rpx;
}
.btn-row .btn {
  flex: 1;
}

/* 底部固定操作栏（页面内使用 scroll 留白 + safe-bottom） */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--xl-line);
  box-shadow: 0 -8rpx 30rpx rgba(23, 32, 51, 0.05);
  backdrop-filter: blur(12rpx);
}
.bottom-placeholder {
  height: 180rpx;
}

/* ============ 表单 ============ */
.form-item {
  margin-bottom: 30rpx;
}
.form-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--xl-ink);
  margin-bottom: 16rpx;
}
.form-label::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  border-radius: 6rpx;
  background: var(--xl-brand);
}
.form-optional {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--xl-muted-2);
}
.form-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--xl-muted);
  line-height: 1.5;
}
.form-error {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--xl-danger);
}
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 26rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--xl-ink);
  background: #f5f7fb;
  border: 2rpx solid transparent;
}
.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--xl-ink);
  background: #f5f7fb;
  border: 2rpx solid transparent;
}
.input-placeholder {
  color: var(--xl-muted-2);
}
.required {
  color: var(--xl-danger);
}

/* ============ 数据展示 ============ */
.stat-row {
  display: flex;
  gap: 16rpx;
}
.stat {
  flex: 1;
  padding: 24rpx 20rpx;
  border-radius: 22rpx;
  background: #f7f9fc;
  text-align: center;
  min-width: 0;
}
.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--xl-ink);
  line-height: 1.2;
}
.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--xl-muted);
}
.divider {
  height: 1rpx;
  background: var(--xl-line-2);
  margin: 22rpx 0;
}
.progress {
  height: 14rpx;
  border-radius: 999rpx;
  background: #eef1f6;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff6b2c 0%, #ff9a5a 100%);
  transition: width 0.4s ease;
}
.progress-bar-green {
  background: linear-gradient(90deg, #12b76a 0%, #4fd99c 100%);
}

/* ============ 状态 / 动画 ============ */
.skeleton {
  border-radius: 18rpx;
  background: linear-gradient(90deg, #eef1f6 25%, #f7f9fc 37%, #eef1f6 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.2s ease infinite;
}
.skeleton-line {
  height: 28rpx;
  margin-bottom: 16rpx;
}
@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
.fade-in {
  animation: xl-fade-in 0.32s ease both;
}
@keyframes xl-fade-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.slide-up {
  animation: xl-slide-up 0.36s cubic-bezier(0.22, 0.8, 0.3, 1) both;
}
@keyframes xl-slide-up {
  from {
    opacity: 0;
    transform: translateY(36rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.spin {
  animation: xl-spin 0.9s linear infinite;
}
@keyframes xl-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
.pulse {
  animation: xl-pulse 1.6s ease-in-out infinite;
}
@keyframes xl-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.45;
  }
}

/* ============ 其他 ============ */
.hairline {
  height: 1rpx;
  background: var(--xl-line);
}
.safe-bottom {
  height: calc(32rpx + env(safe-area-inset-bottom));
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.link {
  color: var(--xl-brand);
  font-weight: 600;
}
.disclaimer {
  padding: 24rpx 8rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--xl-muted-2);
  text-align: center;
}
